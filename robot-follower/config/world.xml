<mujoco>
  <!-- Environment: floor + walls + obstacles -->

  <!-- Floor -->
  <geom name="floor" type="plane" size="10 10 0.1" rgba="0.85 0.85 0.8 1"
        friction="1.0 0.005 0.001"/>

  <!-- Room walls (10m x 10m) -->
  <body name="walls" pos="0 0 0">
    <geom name="wall_north" type="box" size="5 0.05 0.5" pos="0 5 0.5"
          rgba="0.6 0.6 0.65 1" contype="1" conaffinity="1"/>
    <geom name="wall_south" type="box" size="5 0.05 0.5" pos="0 -5 0.5"
          rgba="0.6 0.6 0.65 1" contype="1" conaffinity="1"/>
    <geom name="wall_east" type="box" size="0.05 5 0.5" pos="5 0 0.5"
          rgba="0.6 0.6 0.65 1" contype="1" conaffinity="1"/>
    <geom name="wall_west" type="box" size="0.05 5 0.5" pos="-5 0 0.5"
          rgba="0.6 0.6 0.65 1" contype="1" conaffinity="1"/>
  </body>

  <!-- Obstacles -->
  <body name="obstacles" pos="0 0 0">
    <!-- Central pillar -->
    <geom name="pillar1" type="cylinder" size="0.3 0.5" pos="1.5 1.5 0.5"
          rgba="0.7 0.5 0.3 1" contype="1" conaffinity="1"/>
    <!-- L-shaped wall segment -->
    <geom name="wall_seg1" type="box" size="0.8 0.05 0.4" pos="-1.5 -1.0 0.4"
          rgba="0.65 0.6 0.55 1" contype="1" conaffinity="1"/>
    <geom name="wall_seg2" type="box" size="0.05 0.5 0.4" pos="-2.25 -0.55 0.4"
          rgba="0.65 0.6 0.55 1" contype="1" conaffinity="1"/>
    <!-- Boxes -->
    <geom name="box1" type="box" size="0.25 0.25 0.3" pos="2.5 -2.0 0.3"
          rgba="0.5 0.6 0.4 1" contype="1" conaffinity="1"/>
    <geom name="box2" type="box" size="0.2 0.4 0.25" pos="-3.0 2.5 0.25"
          rgba="0.5 0.4 0.6 1" contype="1" conaffinity="1"/>
  </body>
</mujoco>
