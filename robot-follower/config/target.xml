<mujoco>
  <!-- Person-like target: upright capsule with head sphere -->
  <body name="target" pos="3 0 0.5">
    <freejoint name="target_free"/>
    <!-- Torso -->
    <geom name="target_torso" type="capsule" size="0.1 0.25"
          rgba="0.9 0.2 0.2 1" mass="5.0"/>
    <!-- Head -->
    <geom name="target_head" type="sphere" size="0.12" pos="0 0 0.37"
          rgba="0.95 0.75 0.6 1" mass="0.5"/>
    <!-- Reference site for sensing -->
    <site name="target_site" pos="0 0 0" size="0.02" rgba="1 1 0 0.5"/>
  </body>
</mujoco>
