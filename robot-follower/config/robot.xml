<mujoco>
  <!-- Differential-drive robot: box chassis + 2 cylinder wheels + rear caster -->
  <body name="robot" pos="0 0 0.08">
    <freejoint name="robot_free"/>
    <geom name="chassis" type="box" size="0.15 0.1 0.04" rgba="0.2 0.4 0.8 1"
          mass="2.0" friction="0.5 0.005 0.001"/>

    <!-- Front marker for heading visualization -->
    <geom name="front_marker" type="box" size="0.02 0.04 0.045" pos="0.13 0 0"
          rgba="1 0.3 0.1 1" mass="0.01"/>

    <!-- Left wheel -->
    <body name="left_wheel" pos="0 0.12 -0.02">
      <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.02"/>
      <geom name="left_wheel_geom" type="cylinder" size="0.06 0.02"
            euler="90 0 0" rgba="0.3 0.3 0.3 1" mass="0.3"
            friction="1.5 0.005 0.001" condim="6"/>
    </body>

    <!-- Right wheel -->
    <body name="right_wheel" pos="0 -0.12 -0.02">
      <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.02"/>
      <geom name="right_wheel_geom" type="cylinder" size="0.06 0.02"
            euler="90 0 0" rgba="0.3 0.3 0.3 1" mass="0.3"
            friction="1.5 0.005 0.001" condim="6"/>
    </body>

    <!-- Rear caster (sphere for stability) -->
    <body name="caster" pos="-0.12 0 -0.04">
      <joint name="caster_x" type="hinge" axis="1 0 0" damping="0.001"/>
      <joint name="caster_y" type="hinge" axis="0 1 0" damping="0.001"/>
      <geom name="caster_geom" type="sphere" size="0.02"
            rgba="0.5 0.5 0.5 1" mass="0.05"
            friction="0.1 0.005 0.001" condim="3"/>
    </body>
  </body>
</mujoco>
